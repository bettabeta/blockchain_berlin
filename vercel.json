{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": null,
  "redirects": [
    {
      "source": "/ai-licensing-scan.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/ai-licensing-scan.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pandr.de" }],
      "destination": "https://pandr.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "blockchainberlin.de" }],
      "destination": "https://pandr.de/berlin-blockchain/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.blockchainberlin.de" }],
      "destination": "https://pandr.de/berlin-blockchain/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/berlin-blockchain",
      "destination": "/berlin-blockchain/index.html"
    },
    {
      "source": "/en/berlin-blockchain",
      "destination": "/en/berlin-blockchain/index.html"
    },
    {
      "source": "/en/berlin-blockchain/",
      "destination": "/en/berlin-blockchain/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
